---
import { Image } from 'astro:assets';
import methasenseLogo from '../assets/images/methasense-logo.png';

const baseUrl = import.meta.env.BASE_URL;

interface Props {
    variant?: 'header' | 'footer' | 'dark';
}

const { variant = 'header' } = Astro.props;

const getLogoHeight = () => {
    switch (variant) {
        case 'header':
            return 48;
        case 'footer':
            return 40;
        default:
            return 40;
    }
};
---

<a href={baseUrl} class="logo transition-opacity duration-200 hover:opacity-80">
    <Image src={methasenseLogo} alt="MethaSense" height={getLogoHeight()} />
</a>
